{
  "name": "seo-maker",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @seo-maker/db generate",
    "db:migrate": "pnpm --filter @seo-maker/db migrate",
    "db:deploy": "pnpm db:up && pnpm --filter @seo-maker/db migrate:deploy",
    "knowledge:ingest": "pnpm --filter @seo-maker/db knowledge:ingest"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.21.0"
}
