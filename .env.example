# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Local Docker Postgres + Redis — pnpm db:up
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/seo_maker"
REDIS_URL="redis://localhost:6380"

# Google PageSpeed Insights API key, used by apps/worker for the Performance tab.
# Create one in Google Cloud Console: enable "PageSpeed Insights API", then Credentials > API key.
PAGESPEED_API_KEY=

# AI providers. One key per provider; a provider without a key is skipped, and
# with no keys at all the app runs with AI features unavailable (the crawler and
# deterministic scoring never need a provider). AI never runs after a crawl on
# its own: every AI request is started by a user.
AI_API_KEY_GROQ=
AI_API_KEY_GEMINI=
# A second Gemini account, with its own quota, for site and competitor work.
AI_API_KEY_GEMINI2=
# Features with no route of their own use this provider (groq | gemini | gemini2).
AI_PROVIDER_DEFAULT=groq
# Model per provider. Defaults were verified against each provider's model list:
AI_MODEL_GROQ=openai/gpt-oss-120b
AI_MODEL_GEMINI=gemini-3.5-flash
AI_MODEL_GEMINI2=gemini-3.5-flash
# Routing: short page work -> Groq; long text and images -> Gemini; site and
# competitor reasoning -> the second Gemini account. Override one feature at a time:
# AI_ROUTE_SITE_STRATEGY=gemini
# AI_ROUTE_CONTENT=groq
# Tried in this order when the routed provider fails (billing, rate limit, outage):
# AI_PROVIDER_FALLBACKS=gemini,groq,gemini2
# Gemini thinking level: minimal | low | medium | high
# AI_GEMINI_THINKING=low
# System-wide AI capacity per 24 hours, in tokens, across all users. Internal
# cost control; never shown to users.
# AI_DAILY_TOKEN_BUDGET=200000
# Concurrent AI page jobs. Keep 1 on Groq free tier (8k tokens/min); raise on paid tiers.
AI_PAGE_CONCURRENCY=1
# Pages fetched in parallel per crawl (1-4). 3 is fast and still light on CPU.
CRAWL_CONCURRENCY=3
# Optional overrides
# AI_BASE_URL_GROQ=https://api.groq.com/openai/v1
# AI_TIMEOUT_MS=45000
# AI_MAX_RETRIES=2
# Compare models on the fixed evaluation benchmark before switching:
#   pnpm ai:benchmark --models groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash
