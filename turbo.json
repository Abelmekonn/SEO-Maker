{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "outputs": [],
      "inputs": ["src/**", "vitest.config.ts", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
