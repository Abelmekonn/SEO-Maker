# The knowledge folder: ship what the code needs, keep the bulk out.
# knowledge-corpus.json is a runtime dependency of packages/db/src/ingest-knowledge.ts,
# so a fresh clone must have it. The source PDFs (~12 MB) and the v1 archive are local.
knowledge/*
!knowledge/knowledge-corpus.json
!knowledge/knowledge-item.schema.json
!knowledge/README.md
!knowledge/build/
