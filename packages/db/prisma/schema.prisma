generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  userId    String   @id
  email     String   @unique
  plan      String   @default("free")
  source    String   @default("signup")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  rootUrl     String
  name        String
  maxPages    Int       @default(1)
  status      String    @default("pending")
  perfStatus  String    @default("idle")
  perfError   String?
  perfRunAt   DateTime?
  perfDone    Int       @default(0)
  perfTotal   Int       @default(0)
  perfPageIds Json?

  // Competitor discovery progress. Mirrors the perf* columns above so the UI can
  // poll the project row instead of a separate run table.
  compStatus     String    @default("idle")
  compPhase      String?
  compError      String?
  compRunAt      DateTime?
  compDone       Int       @default(0)
  compTotal      Int       @default(0)
  compPhaseDone  Int       @default(0)
  compPhaseTotal Int       @default(0)
  compProviderOk Boolean   @default(false)
  compAiUsed     Boolean   @default(false)

  /// analysisMode: quick | deep. Quick runs from a URL alone (Phase 0.6).
  analysisMode String @default("quick")

  // Business context for Deep analysis (Phase 0.5). All optional: Quick mode
  // must keep working with none of it, and the AI layer stays conservative
  // rather than inventing values that are missing here.
  businessName        String?
  businessType        String?
  industry            String?
  businessDescription String?
  targetAudience      String?
  targetLocation      String?
  servicesProducts    Json?
  primaryGoal         String?
  targetKeywords      Json?
  contextUpdatedAt    DateTime?

  /// The crawl whose pages the dashboard shows. Older crawls are kept for history.
  latestCrawlId String?

  // GEO / AI Search Readiness progress. Same shape as the perf* and comp*
  // blocks so the UI polls the project row rather than a separate run table.
  geoStatus        String    @default("idle")
  geoPhase         String?
  geoError         String?
  geoRunAt         DateTime?
  geoDone          Int       @default(0)
  geoTotal         Int       @default(0)
  geoAiUsed        Boolean   @default(false)
  geoLatestAuditId String?

  /// AI visibility tracking: not_configured | configured | running | error.
  ///
  /// The only column the AI visibility UI reads. It exists now so that screen
  /// can be written once and go live later without a migration. Nothing runs
  /// prompts against assistants yet, and no placeholder rows are ever created.
  aiVisibilityStatus String @default("not_configured")

  createdAt         DateTime          @default(now())
  pages             Page[]
  crawls            Crawl[]
  competitors       Competitor[]
  competitorQueries CompetitorQuery[]
  contentGaps       ContentGap[]
  opportunities     Opportunity[]
  aiResults         AiResult[]

  geoAudits        GeoAudit[]
  geoProfiles      AiBusinessProfile[]
  geoEntities      AiEntity[]
  geoRelations     AiEntityRelationship[]
  geoAnswers       AiAnswerOpportunity[]
  geoCitations     AiCitationOpportunity[]
  geoOpportunities GeoOpportunity[]

  @@index([userId])
}

/// One crawl run.
///
/// Replaces overwriting the project's pages in place, which wiped the previous
/// state on every re-crawl and left nothing for the Fix -> Re-crawl -> Measure
/// loop (PRD section 52) to compare against.
///
/// status: pending | crawling | analyzing | completed | failed | cancelled
model Crawl {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status   String  @default("pending")
  maxPages Int     @default(1)
  error    String?

  // Reliability counters (PRD section 42). Failures are real rows now, not
  // values that vanished when a request errored.
  discovered Int @default(0)
  queued     Int @default(0)
  crawled    Int @default(0)
  analyzed   Int @default(0)
  failed     Int @default(0)
  skipped    Int @default(0)

  /// Requests spent, which exceeds `crawled` when sitemap URLs redirect onto each other.
  requests Int @default(0)

  // Site-wide audits, stored per crawl so a comparison matches like with like.
  robotsAudit  Json?
  sitemapAudit Json?
  /// Raw robots.txt, capped at 100 KB.
  ///
  /// `robotsAudit` only holds the directives that apply to OUR crawler token.
  /// The GEO layer has to evaluate the groups for OAI-SearchBot, GPTBot and the
  /// rest, and keeping the text the crawler already fetched lets it do that
  /// with zero extra HTTP requests.
  robotsTxt    String?
  /// Seed plan summary: sections covered, deferred/duplicate/off-site counts.
  seedPlan     Json?

  // Scores snapshotted at completion, so a comparison never has to re-derive
  // them from pages that may since have been pruned.
  seoScore       Float?
  technicalScore Float?
  onPageScore    Float?
  issueCount     Int    @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  pages     Page[]
  issues    PageIssue[]
  geoAudits GeoAudit[]

  @@index([projectId, startedAt])
}

/// status: pending | crawling | analyzing | analyzed | failed | excluded
model Page {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Null only for the seed row created before the first crawl starts.
  crawlId   String?
  crawl     Crawl?  @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  url           String
  finalUrl      String?
  isHttps       Boolean?
  statusCode    Int?
  pageType      String?
  /// 0-1 confidence from the deterministic classifier.
  pageTypeScore Float?
  title         String?
  metaDesc      String?
  h1            String?
  /// Multiple H1s are their own finding; presence alone was never enough.
  h1Count       Int?
  h2Count       Int?
  h3Count       Int?
  canonicalUrl  String?
  wordCount     Int?
  imageCount    Int?
  missingAlt    Int?
  internalLinks Int?
  externalLinks Int?
  schemaCount   Int?
  robotsTxtUrl  String?
  robotsOk      Boolean?
  sitemapUrl    String?
  hasSitemap    Boolean?
  xRobotsTag    String?
  robotsMeta    String?
  indexable     Boolean?

  /// Whether the site's own sitemap lists this URL. Null when there is no sitemap.
  /// This is what lets the product tell deliberate noindex from a contradiction.
  inSitemap        Boolean?
  /// Whether robots.txt disallows this path for our crawler.
  robotsDisallowed Boolean?

  // Redirect and transport evidence. `finalUrl` used to be a copy of `url`, so
  // no redirect was ever recorded on any page of any site.
  redirectCount  Int?
  responseTimeMs Int?
  contentType    String?
  language       String?
  depth          Int?
  /// How this URL entered the crawl: seed | sitemap | link.
  discoveredVia  String?

  // Phase 0.2 evidence. The counts above stay for the existing deterministic
  // scoring; these carry the actual text and structure the AI layer needs and
  // must not invent.
  content     String?
  contentHash String?
  evidence    Json?

  /// Why a fetch failed, so a failure is a visible row rather than a missing one.
  errorType String?
  error     String?

  seoSuggestion Json?
  status        String             @default("pending")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  performance   PerformanceAudit[]
  issues        PageIssue[]
  aiResults     AiResult[]

  geoAnswerMatches   AiAnswerOpportunity[]
  geoCitationSignals AiCitationOpportunity[]

  @@index([projectId])
  @@index([crawlId])
  @@index([crawlId, status])
}

/// One deterministic finding, persisted rather than recomputed on every render.
/// Shape matches PRD section 45 so the UI, scoring engine, AI layer and reports
/// all consume the same record.
///
/// status: warning | fail    severity: low | medium | high | critical
model PageIssue {
  id      String @id @default(cuid())
  pageId  String
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  crawlId String
  crawl   Crawl  @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  checkId        String
  status         String
  severity       String
  message        String
  evidence       String?
  recommendation String?

  createdAt DateTime @default(now())

  @@unique([pageId, checkId])
  @@index([crawlId, severity])
  @@index([crawlId, checkId])
}

/// Stored AI output (architecture section 13). Nothing writes this until Phase 1;
/// it exists now so AI results never have to live permanently in a JSON column
/// on Page, which the architecture explicitly warns against.
///
/// status: ok | invalid | failed
model AiResult {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageId    String?
  page      Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  feature String
  mode    String @default("quick")

  provider         String
  model            String
  promptVersion    String
  knowledgeVersion String?
  /// Hash of the evidence and context that produced this, for cache reuse.
  inputHash        String

  output Json?
  status String  @default("ok")
  error  String?

  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, feature])
  @@index([pageId, feature])
  @@index([inputHash])
}

model PerformanceAudit {
  id            String   @id @default(cuid())
  pageId        String
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  strategy      String
  performance   Float?
  accessibility Float?
  bestPractices Float?
  seo           Float?
  fcp           Float?
  lcp           Float?
  cls           Float?
  tbt           Float?
  inp           Float?
  /// Lab TTFB and Speed Index were computed but had nowhere to go.
  ttfb          Float?
  speedIndex    Float?
  rawData       Json?
  opportunities Json?
  diagnostics   Json?
  createdAt     DateTime @default(now())

  @@index([pageId])
}

/// source: manual | serp | ai
/// status: pending | queued | crawling | analyzing | ready | failed | skipped
model Competitor {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain      String
  name        String?
  source      String
  /// Deprecated: superseded by `confidence`. Never written; kept to avoid a destructive migration.
  relevance   Float?
  pageCount   Int     @default(0)
  seoScore    Float?
  performance Float?
  status      String
  statusError String?
  metadata    Json?

  /// COMPETITOR CONFIDENCE 0-100. Null when nothing could be measured.
  confidence     Float?
  confidenceBand String?

  crawlDone      Int       @default(0)
  crawlTotal     Int       @default(0)
  lastCrawledAt  DateTime?
  lastAnalyzedAt DateTime?

  title        String?
  description  String?
  country      String?
  language     String?
  businessType String?
  audience     String?

  queryCount    Int    @default(0)
  topQueryCount Int    @default(0)
  avgPosition   Float?

  pinned   Boolean @default(false)
  excluded Boolean @default(false)

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  pages         CompetitorPage[]
  analyses      CompetitorAnalysis[]
  opportunities Opportunity[]

  @@unique([projectId, domain])
  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, confidence])
}

model CompetitorPage {
  id              String     @id @default(cuid())
  competitorId    String
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  url             String
  finalUrl        String?
  isHttps         Boolean?
  statusCode      Int?
  title           String?
  metaDescription String?
  h1              String?
  h2Count         Int?
  canonicalUrl    String?
  wordCount       Int?
  internalLinks   Int?
  imageCount      Int?
  missingAlt      Int?
  schemaCount     Int?
  schema          Json?
  indexable       Boolean?
  xRobotsTag      String?
  pageType        String?
  seoScore        Float?
  rawData         Json?
  status          String     @default("pending")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([competitorId, url])
  @@index([competitorId])
}

/// source: seed | ai | page | manual
/// intent: transactional | commercial | informational | navigational
/// status: pending | fetched | unavailable | failed
model CompetitorQuery {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  query        String
  source       String
  intent       String    @default("informational")
  /// NOT NULL so the unique tuple works — Postgres treats NULLs as distinct.
  locationCode Int       @default(2840)
  languageCode String    @default("en")
  relevance    Float?
  searchVolume Int?
  difficulty   Float?
  cpc          Float?
  /// Where the user's own site ranks for this query, when known.
  selfPosition Int?
  selfUrl      String?
  status       String    @default("pending")
  checkedAt    DateTime?
  createdAt    DateTime  @default(now())

  results SerpResult[]

  @@unique([projectId, query, locationCode, languageCode])
  @@index([projectId])
}

/// resultType: organic | featured_snippet | paa | local_pack
model SerpResult {
  id         String          @id @default(cuid())
  queryId    String
  query      CompetitorQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  position   Int
  domain     String
  url        String
  title      String?
  snippet    String?
  resultType String          @default("organic")
  provider   String
  fetchedAt  DateTime        @default(now())

  @@unique([queryId, position, resultType])
  @@index([queryId])
  @@index([domain])
}

/// Append-only. One row per analysis run, which gives per-competitor history.
model CompetitorAnalysis {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  seoScore            Float?
  technicalScore      Float?
  onPageScore         Float?
  contentScore        Float?
  performanceScore    Float?
  internalLinksScore  Float?
  structuredDataScore Float?
  /// Weights after redistribution, so a stored score can always be audited.
  measuredWeights     Json?
  /// SeoDimensionId[] that could not be measured.
  notMeasured         Json?

  confidence      Float?
  confidenceParts Json?

  pagesAnalyzed    Int    @default(0)
  avgWordCount     Float?
  avgInternalLinks Float?
  schemaCoverage   Float?

  summary    String?
  strengths  Json?
  weaknesses Json?

  aiUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([competitorId, createdAt])
}

/// kind: topic | keyword | page-type | schema | depth
/// status: open | in-progress | done | dismissed
model ContentGap {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind   String
  title  String
  detail String?
  query  String?

  selfUrl       String?
  selfWordCount Int?

  competitorCount        Int     @default(0)
  competitorIds          Json?
  avgCompetitorWordCount Float?
  bestCompetitorUrl      String?

  searchVolume  Int?
  relevance     Float?
  businessValue Float?

  status    String   @default("open")
  aiUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity?

  @@index([projectId, status])
}

/// category: content | technical | onpage | performance | structured-data | internal-links
/// effort: low | medium | high
/// status: open | in-progress | done | dismissed
model Opportunity {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  gapId String?     @unique
  gap   ContentGap? @relation(fields: [gapId], references: [id], onDelete: Cascade)

  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  category  String
  title     String
  rationale String?
  action    String?

  /// OPPORTUNITY SCORE 0-100.
  score Float
  band  String
  parts Json?

  effort String?

  status    String   @default("open")
  aiUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status, score])
}

/// One atomic SEO/GEO knowledge item (Phase 1.5).
///
/// Mirrors knowledge/knowledge-corpus.json, which is the authored source of
/// truth. Rows are replaced wholesale by `pnpm knowledge:ingest`; nothing else
/// writes here, so the corpus file and the table can never drift.
///
/// knowledgeType: authoritative | heuristic | research | myth
/// status:        active | revised | superseded | needs_verification
model KnowledgeItem {
  /// The corpus slug, e.g. "seo-tech-robots-5xx-disallow".
  id String @id

  domain        String
  category      String
  topic         String
  subtopic      String?
  knowledgeType String
  claimType     String

  title             String
  principle         String
  explanation       String
  whyItMatters      String
  recommendedAction String
  /// Never null. An item with no stated limit is usually an overclaim.
  limitations       String

  appliesWhen      Json
  doesNotApplyWhen Json
  relatedIssues    Json
  relatedKnowledge Json

  /// Deterministic CheckIds this item can explain. The primary retrieval key,
  /// alongside `topic` — Phase 1.7 routes on metadata before embeddings.
  checks        String[]
  applicability String[]
  entities      String[]
  tags          String[]
  /// Populated in Phase 2, when page-type-specific knowledge is added.
  pageTypes     String[]

  evidenceType     String
  evidenceStrength String
  confidence       String

  sourceName      String
  sourcePublisher String
  sourceUrl       String?
  sourceType      String
  sourceLocation  String?
  sourceQuote     String?
  sourceLocalPath String?

  /// False when the source document was not read in the pass that produced the
  /// item. Such items carry no quote and no location, and retrieval prefers a
  /// verified item when both cover the same ground.
  verified      Boolean
  sourceSupport String

  status            String
  supersededBy      String?
  /// Ids in KnowledgePolicy that override this item's phrasing.
  governingPolicies String[]

  version       String
  lastVerified  String?
  reviewBy      String?
  /// Corpus build stamp, copied to AiResult.knowledgeVersion for traceability.
  corpusVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, knowledgeType])
  @@index([topic])
  @@index([domain, category])
}

/// A resolved conflict (Phase 1.5). Overrides an item's own phrasing.
///
/// Every disagreement found during extraction is decided rather than left open,
/// so the model never has to arbitrate between two sources at generation time.
model KnowledgePolicy {
  id          String  @id
  question    String
  decision    String
  rationale   String
  directive   String
  /// Phrasings the model must never emit.
  neverSay    Json
  /// The rejected position, kept so the model can recognise and contradict it.
  losingClaim String
  caveat      String?

  appliesToItems  String[]
  appliesToChecks String[]

  confidence    String
  corpusVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// GEO / AI Search Visibility
//
// The whole cluster follows one rule: the LLM's output is a CLAIM, stored with
// its own confidence and its evidence URLs. Deterministic code verifies the
// claim and writes the score. No column here ever holds a model-generated
// 0-100 number.
// ---------------------------------------------------------------------------

/// One GEO run. Append-only, like PerformanceAudit and CompetitorAnalysis:
/// the run is the record, and re-running never overwrites what the user saw.
///
/// status: pending | running | completed | partial | failed
/// `partial` is a real outcome, not a soft failure - at least one dimension was
/// measured and at least one phase could not run. A provider outage lands here
/// with the deterministic half of the score fully intact.
model GeoAudit {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crawlId   String?
  crawl     Crawl?  @relation(fields: [crawlId], references: [id], onDelete: SetNull)

  status  String  @default("pending")
  phase   String?
  error   String?
  mode    String  @default("quick")
  /// crawl | manual | retry
  trigger String  @default("crawl")

  /// Hash of the selected pages' content hashes plus the ruleset and prompt
  /// versions. An identical fingerprint with force=false short-circuits the run
  /// before any model call, which is what keeps a page load from spending
  /// credits.
  inputFingerprint String
  rulesetVersion   String

  aiAvailable Boolean @default(false)
  aiUsed      Boolean @default(false)

  /// AI Search Readiness, 0-100. Null when nothing could be measured - the UI
  /// prints a sentence in that case and never a zero.
  readinessScore Float?
  readinessBand  String?

  entityClarity         Float?
  contentExtractability Float?
  answerCoverage        Float?
  structuredData        Float?
  aiCrawlerAccess       Float?
  citationReadiness     Float?
  businessInfo          Float?

  /// Weights after redistribution, so a stored score can always be audited.
  measuredWeights Json?
  /// [{ dimension, reason }] for every dimension that could not be measured.
  notMeasured     Json?
  parts           Json?
  /// Which dimensions ran on a narrowed deterministic fallback.
  basis           Json?

  pagesSelected   Int   @default(0)
  pagesAnalyzed   Int   @default(0)
  /// Pages excluded for budget, with their importance - visible, not vanished.
  deferredPages   Json?
  tokensEstimated Int?
  aiCalls         Int   @default(0)
  aiFailures      Int   @default(0)

  /// Per-agent PASS/FAIL/UNKNOWN/NOT_TESTED grid, rendered verbatim.
  crawlerMatrix     Json?
  entityFacets      Json?
  extractability    Json?
  schemaCensus      Json?
  businessInfoItems Json?
  citationSignals   Json?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  profile       AiBusinessProfile?
  answers       AiAnswerOpportunity[]
  citations     AiCitationOpportunity[]
  opportunities GeoOpportunity[]

  @@index([projectId, startedAt])
  @@index([projectId, status])
  @@index([projectId, inputFingerprint])
}

/// The AI's reading of what this business is.
///
/// Every field is a CLAIM with the model's own confidence. `verifiedFacets` is
/// written by deterministic code after checking each claim against the crawl,
/// and that is what feeds Entity Clarity - not the confidences here.
model AiBusinessProfile {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  geoAuditId String   @unique
  geoAudit   GeoAudit @relation(fields: [geoAuditId], references: [id], onDelete: Cascade)

  businessName           String?
  businessNameConfidence Float?
  businessType           String?
  businessTypeConfidence Float?
  industry               String?
  industryConfidence     Float?
  description            String?
  descriptionConfidence  Float?

  /// none | regional | local. "none" nulls the location facets rather than
  /// failing a business that genuinely has no location to publish.
  locationRelevance   String?
  hasPhysicalPremises Boolean?

  confidence       Float?
  needsHumanReview Boolean @default(true)
  groundedIn       Json
  /// { facet: { raw, slots, evidence[] } }, written by deterministic code.
  verifiedFacets   Json?

  /// ai | user. A user edit supersedes the reading and is never overwritten.
  source     String  @default("ai")
  aiResultId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities      AiEntity[]
  relationships AiEntityRelationship[]

  @@index([projectId, createdAt])
}

/// kind: service | product | audience | location | topic | brand | person
model AiEntity {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profileId String
  profile   AiBusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  kind        String
  name        String
  /// Lowercased and stemmed. The join key deterministic verification uses.
  normalized  String
  description String?
  /// The model's confidence in this extraction. Never a quality score.
  confidence  Float

  evidenceUrls   Json
  /// True when `normalized` was found in a crawled page's title, h1 or headings.
  verified       Boolean @default(false)
  verifiedPageId String?

  createdAt DateTime @default(now())

  fromRelationships AiEntityRelationship[] @relation("GeoEntityFrom")
  toRelationships   AiEntityRelationship[] @relation("GeoEntityTo")

  @@unique([profileId, kind, normalized])
  @@index([projectId, kind])
}

/// kind: offers | serves | located-in | about | part-of | audience-of
model AiEntityRelationship {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profileId String
  profile   AiBusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  fromEntityId String
  fromEntity   AiEntity @relation("GeoEntityFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntityId   String
  toEntity     AiEntity @relation("GeoEntityTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  kind         String
  confidence   Float
  evidenceUrls Json

  createdAt DateTime @default(now())

  @@unique([profileId, fromEntityId, toEntityId, kind])
  @@index([profileId])
}

/// A generated question and its DETERMINISTICALLY measured coverage.
///
/// coverageStatus: answered | partially_answered | not_found
/// intent: informational | commercial | transactional | navigational | local
model AiAnswerOpportunity {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  geoAuditId String
  geoAudit   GeoAudit @relation(fields: [geoAuditId], references: [id], onDelete: Cascade)

  question        String
  /// Hash of the normalized question. Stable across runs, and the key a future
  /// AiPrompt row joins on without a backfill.
  questionHash    String
  intent          String
  topic           String?
  relatedEntityId String?
  relatedService  String?

  /// What the model said an answer must contain. Re-running the matcher over
  /// these reproduces coverageScore exactly, with no model call.
  answerTerms   Json
  disqualifiers Json?
  /// The model's own importance weighting. Ranks the list, never scores it.
  importance    Float?

  coverageStatus String
  coverageScore  Float
  matchedPageId  String?
  matchedPage    Page?   @relation(fields: [matchedPageId], references: [id], onDelete: SetNull)
  matchedHeading String?
  matchedExcerpt String?

  verifiedByAi   Boolean @default(false)
  missingAspects Json?

  /// Promotable to an AiPrompt when AI visibility tracking ships.
  promotable Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([geoAuditId, questionHash])
  @@index([geoAuditId, coverageStatus])
  @@index([projectId, questionHash])
}

/// signal: specificity | freshness | attribution | identity | definition | faq |
///         outbound-source | claim
/// status: present | weak | absent
model AiCitationOpportunity {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  geoAuditId String
  geoAudit   GeoAudit @relation(fields: [geoAuditId], references: [id], onDelete: Cascade)
  pageId     String?
  page       Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  signal   String
  status   String
  /// The measured numbers behind the status. Rendered, not hidden.
  observed Json?

  /// A verbatim claim the page makes. Dropped before insert when it is not a
  /// literal substring of Page.content, so this column cannot hold an invention.
  claimText     String?
  claimKind     String?
  supportType   String?
  claimVerified Boolean @default(false)
  sourceUrl     String?

  recommendation String?

  createdAt DateTime @default(now())

  @@index([geoAuditId, signal])
  @@index([pageId])
}

/// A GEO finding.
///
/// Separate from `Opportunity` because that model requires a non-null score and
/// band. A finding such as "OAI-SearchBot access is UNKNOWN because robots.txt
/// returned 503" has no honest score, and writing 0 would be the
/// unmeasured-as-zero failure the scoring layer exists to prevent.
///
/// type: ENTITY_CLARITY | ENTITY_CONSISTENCY | STRUCTURED_DATA |
///       AI_CRAWLER_ACCESS | ANSWER_GAP | CONTENT_EXTRACTABILITY |
///       BUSINESS_INFORMATION | CITATION_READINESS | INTERNAL_LINKING |
///       SERVICE_COVERAGE | LOCATION_COVERAGE
/// severity: critical | high | medium | low
/// effort: low | medium | high
/// status: open | in-progress | done | dismissed
model GeoOpportunity {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  geoAuditId String
  geoAudit   GeoAudit @relation(fields: [geoAuditId], references: [id], onDelete: Cascade)

  type              String
  title             String
  explanation       String
  recommendedAction String

  severity        String
  /// AI Search Opportunity, 0-100. Deterministic; the LLM never sets it.
  priority        Float
  priorityBand    String
  /// The inputs behind `priority`, so it is always auditable.
  priorityParts   Json?
  estimatedEffort String

  /// The readiness dimension this finding would move.
  dimension String?

  affectedPageIds Json
  affectedUrls    Json
  /// [{ label, value, source }] - every entry traceable to a Page column,
  /// a PageEvidence field or robots.txt.
  evidence        Json

  /// True only when the title/explanation/action prose came from the model.
  aiUsed     Boolean @default(false)
  aiResultId String?

  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status, priority])
  @@index([geoAuditId, type])
}
