generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  userId    String   @id
  email     String   @unique
  plan      String   @default("free")
  source    String   @default("signup")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One metered action a user started: a crawl or an AI generation.
///
/// The ledger plan allowances are counted from (Free: 2 AI generations a day,
/// 10 a week, one re-crawl per site). Deliberately not related to Project:
/// deleting a site and adding it again must not reset what was used.
///
/// A record is reserved before the job is queued, inside a per-user lock, so
/// two concurrent requests cannot both take the last unit. The worker settles
/// it when the job ends. Failed, cancelled and refunded records never count,
/// so a user is not charged for a generation that produced nothing.
///
/// kind:   crawl | ai
/// scope:  crawl: initial | recrawl | page     ai: page | site | competitor
/// status: reserved | succeeded | failed | cancelled | refunded
model UsageRecord {
  id        String  @id @default(cuid())
  userId    String
  kind      String
  scope     String
  /// Project.siteKey. Crawl allowances are per site.
  siteKey   String?
  projectId String?
  /// The page an AI generation was for, by URL identity (pageKeyOf).
  pageKey   String?
  /// What was requested, e.g. ["title","meta"]. For support, not billing.
  features  Json?
  status    String  @default("reserved")
  /// Client-supplied idempotency key: a retried request returns this record
  /// instead of taking another unit.
  requestKey String?
  /// Why it failed or was refunded. Internal.
  error      String?

  createdAt DateTime  @default(now())
  settledAt DateTime?

  @@unique([userId, requestKey])
  @@index([userId, kind, createdAt])
  @@index([userId, kind, siteKey])
}

model Project {
  id          String       @id @default(cuid())
  userId      String
  rootUrl     String
  name        String
  maxPages    Int          @default(1)
  status      String       @default("pending")
  perfStatus  String       @default("idle")
  perfError   String?
  perfRunAt   DateTime?
  perfDone    Int          @default(0)
  perfTotal   Int          @default(0)
  perfPageIds Json?

  // Competitor discovery progress. Mirrors the perf* columns above so the UI can
  // poll the project row instead of a separate run table.
  compStatus     String    @default("idle")
  compPhase      String?
  compError      String?
  compRunAt      DateTime?
  compDone       Int       @default(0)
  compTotal      Int       @default(0)
  compPhaseDone  Int       @default(0)
  compPhaseTotal Int       @default(0)
  compProviderOk Boolean   @default(false)
  compAiUsed     Boolean   @default(false)

  /// analysisMode: quick | deep. Quick runs from a URL alone (Phase 0.6).
  analysisMode String @default("quick")

  // Business context for Deep analysis (Phase 0.5). All optional: Quick mode
  // must keep working with none of it, and the AI layer stays conservative
  // rather than inventing values that are missing here.
  businessName        String?
  businessType        String?
  industry            String?
  businessDescription String?
  targetAudience      String?
  targetLocation      String?
  servicesProducts    Json?
  primaryGoal         String?
  targetKeywords      Json?
  contextUpdatedAt    DateTime?

  /// Page types the user set by URL path, e.g. {"/payments": "product"}.
  /// The crawler applies them over its own classification, so a correction
  /// survives re-crawls, and they unblock AI fixes that need a known type.
  pageTypeOverrides Json?

  /// Deprecated: superseded by SitePage.tier, which stores every page's
  /// classification. Read once, to seed the inventory of a project crawled
  /// before SitePage existed; never written. Kept to avoid a destructive migration.
  pagePriorityOverrides Json?

  // Page discovery: finding the site's URLs and classifying them, without
  // crawling them. Mirrors the perf* and comp* columns so the UI can poll the
  // project row.
  /// idle | queued | running | done | failed
  discoveryStatus String    @default("idle")
  /// initial (a new site) | new-pages (look for pages not known yet)
  discoveryMode   String?
  discoveryError  String?
  discoveryAt     DateTime?
  /// What the last discovery found: Priority / Standard counts and, for a
  /// new-pages check, the pages it added. See DiscoveryResult in the web app.
  discoveryResult Json?

  /// Normalised site identity: host without "www.", plus any path, lower-cased
  /// ("stripe.com", "example.com/blog"). Unique per user, so the same site
  /// cannot be added twice; re-crawling it is the way to refresh it.
  siteKey String?

  /// The crawl whose pages the dashboard shows. Older crawls are kept for history.
  latestCrawlId String?

  createdAt         DateTime          @default(now())
  pages             Page[]
  sitePages         SitePage[]
  crawls            Crawl[]
  competitors       Competitor[]
  competitorQueries CompetitorQuery[]
  contentGaps       ContentGap[]
  opportunities     Opportunity[]
  aiResults         AiResult[]
  performanceAudits PerformanceAudit[]

  @@unique([userId, siteKey])
  @@index([userId])
  @@index([userId, createdAt])
}

/// One crawl run.
///
/// Replaces overwriting the project's pages in place, which wiped the previous
/// state on every re-crawl and left nothing for the Fix -> Re-crawl -> Measure
/// loop (PRD section 52) to compare against.
///
/// status: pending | crawling | analyzing | completed | failed | cancelled
model Crawl {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status   String  @default("pending")
  /// Live progress: starting | discovering | crawling | scoring | done | failed.
  /// Written as the worker moves through a crawl, for the progress view.
  phase    String?
  maxPages Int     @default(1)
  error    String?

  // Reliability counters (PRD section 42). Failures are real rows now, not
  // values that vanished when a request errored.
  discovered Int @default(0)
  queued     Int @default(0)
  crawled    Int @default(0)
  analyzed   Int @default(0)
  failed     Int @default(0)
  skipped    Int @default(0)

  /// Requests spent, which exceeds `crawled` when sitemap URLs redirect onto each other.
  requests Int @default(0)

  // Site-wide audits, stored per crawl so a comparison matches like with like.
  robotsAudit  Json?
  sitemapAudit Json?
  /// Seed plan summary: sections covered, deferred/duplicate/off-site counts.
  seedPlan Json?

  // Scores snapshotted at completion, so a comparison never has to re-derive
  // them from pages that may since have been pruned.
  seoScore       Float?
  technicalScore Float?
  onPageScore    Float?
  issueCount     Int    @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  pages     Page[]
  issues    PageIssue[]
  inventory CrawlInventory?

  @@index([projectId, startedAt])
}

/// The crawl's URL inventory: every URL it discovered that was eligible or
/// blocked by robots.txt, with page type, importance, the reasons for it, and
/// the Priority / Standard tier it was planned and crawled at. Also counts of
/// the invalid, duplicate, asset and external URLs it set aside.
///
/// A table of its own rather than a column on Crawl: it can run to hundreds
/// of kilobytes, and crawl history is read on every overview render. Written
/// by crawls made before SitePage held the inventory; read now only to seed
/// SitePage for a project crawled back then.
model CrawlInventory {
  crawlId String @id
  crawl   Crawl  @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  /// StoredInventory from @seo-maker/core/crawl.
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One page of the site the project knows about: its page inventory.
///
///   discover -> classify (once) -> the user chooses what to crawl -> crawl
///
/// Discovery (sitemaps, robots.txt, the homepage's links) finds the URLs, and
/// each is classified Priority or Standard when it is first found, from
/// deterministic evidence only (see `UrlInventory`). The classification is
/// stored, not recomputed: a re-crawl fetches pages and never re-classifies
/// them, and a "check for new pages" classifies only the URLs it adds. The
/// user can move a page between tiers.
///
/// Separate from Page, which is one crawl's snapshot of a page: a page can be
/// known here and never crawled, like a Standard page nobody selected yet.
/// Matched to Page rows by `pageKey` (see pageKeyOf).
///
/// tier: priority | standard     tierSource: auto | user
/// level: high | medium | low | utility (internal importance, never a ranking)
model SitePage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Normalized URL (normalizePageUrl), as discovery found it.
  url      String
  /// URL identity shared with Page rows and AI results (pageKeyOf).
  pageKey  String
  /// Path and query: "/pricing".
  path     String
  homepage Boolean @default(false)

  tier       String
  /// "user" once the user moved the page between tiers.
  tierSource String @default("auto")
  /// The tier discovery gave it, kept when the user changes `tier`.
  autoTier   String
  level      String
  pageType   String?
  /// Why discovery classified it as it did.
  reasons    Json?
  /// How discovery found it: seed | sitemap | link | user.
  sources    Json?
  inSitemap  Boolean @default(false)

  /// When discovery first found it. Pages one check for new pages added share it.
  discoveredAt  DateTime  @default(now())
  /// When a crawl last fetched it, whatever the outcome. Null: never crawled.
  lastCrawledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, pageKey])
  @@index([projectId, tier])
}

/// status: pending | crawling | analyzing | analyzed | failed | excluded
model Page {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Null only for the seed row created before the first crawl starts.
  crawlId String?
  crawl   Crawl?  @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  url           String
  finalUrl      String?
  isHttps       Boolean?
  statusCode    Int?
  pageType      String?
  /// 0-1 confidence from the deterministic classifier.
  pageTypeScore Float?
  /// Phase 2.5: informational | navigational | commercial | transactional.
  /// Inferred from page type and wording, so it always travels with a confidence.
  searchIntent      String?
  searchIntentScore Float?
  title         String?
  metaDesc      String?
  h1            String?
  /// Multiple H1s are their own finding; presence alone was never enough.
  h1Count       Int?
  h2Count       Int?
  h3Count       Int?
  canonicalUrl  String?
  wordCount     Int?
  imageCount    Int?
  missingAlt    Int?
  internalLinks Int?
  externalLinks Int?
  schemaCount   Int?
  robotsTxtUrl  String?
  robotsOk      Boolean?
  sitemapUrl    String?
  hasSitemap    Boolean?
  xRobotsTag    String?
  robotsMeta    String?
  indexable     Boolean?

  /// Whether the site's own sitemap lists this URL. Null when there is no sitemap.
  /// This is what lets the product tell deliberate noindex from a contradiction.
  inSitemap Boolean?
  /// Whether robots.txt disallows this path for our crawler.
  robotsDisallowed Boolean?

  // Redirect and transport evidence. `finalUrl` used to be a copy of `url`, so
  // no redirect was ever recorded on any page of any site.
  redirectCount  Int?
  responseTimeMs Int?
  contentType    String?
  language       String?
  depth          Int?
  /// How this URL entered the crawl: seed | sitemap | link | user (a page
  /// the user made Priority that the crawl did not otherwise find).
  discoveredVia  String?
  /// The page's priority classification: priority | standard. Separate from
  /// `pageType`, which is what the page is (homepage, service, article...).
  ///
  /// A Priority page keeps the full content below (text, headings, links,
  /// images, structured data) that Page Intelligence and AI ground on. A
  /// Standard page keeps the counts, internal links and headings the site
  /// inventory and the deterministic checks need, without page text, image
  /// details or full JSON-LD. A Standard page becomes Priority when the user
  /// selects it, which fetches its full content. Null on rows from before tiers.
  crawlTier      String?

  // Phase 0.2 evidence. The counts above stay for the existing deterministic
  // scoring; these carry the actual text and structure the AI layer needs and
  // must not invent.
  content     String?
  contentHash String?
  evidence    Json?

  /// Why a fetch failed, so a failure is a visible row rather than a missing one.
  errorType String?
  error     String?

  seoSuggestion Json?
  status        String             @default("pending")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  performance   PerformanceAudit[]
  issues        PageIssue[]
  aiResults     AiResult[]

  @@index([projectId])
  @@index([crawlId])
  @@index([crawlId, status])
  @@index([crawlId, crawlTier])
}

/// One deterministic finding, persisted rather than recomputed on every render.
/// Shape matches PRD section 45 so the UI, scoring engine, AI layer and reports
/// all consume the same record.
///
/// status: warning | fail    severity: low | medium | high | critical
model PageIssue {
  id      String @id @default(cuid())
  pageId  String
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  crawlId String
  crawl   Crawl  @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  checkId        String
  status         String
  severity       String
  message        String
  evidence       String?
  recommendation String?

  createdAt DateTime @default(now())

  @@unique([pageId, checkId])
  @@index([crawlId, severity])
  @@index([crawlId, checkId])
}

/// Stored AI output (architecture section 13). Nothing writes this until Phase 1;
/// it exists now so AI results never have to live permanently in a JSON column
/// on Page, which the architecture explicitly warns against.
///
/// status: ok | invalid | failed
model AiResult {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The page's URL identity (see pageKeyOf), stable across crawls. Page
  /// results are read by this, so a re-crawl keeps them. Null for site-level
  /// features.
  pageKey   String?
  /// The crawl's page row it was written from. Set to null, not deleted, when
  /// that crawl is pruned from history.
  pageId    String?
  page      Page?   @relation(fields: [pageId], references: [id], onDelete: SetNull)
  /// The competitor a competitor-insight result is about (Phase 4.1). Kept,
  /// as null, when the competitor is removed, so spend history survives.
  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  feature String
  mode    String @default("quick")

  provider         String
  model            String
  promptVersion    String
  knowledgeVersion String?
  /// Hash of the evidence and context that produced this, for cache reuse.
  inputHash String

  output Json?
  status String  @default("ok")
  error  String?

  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, feature])
  @@index([pageId, feature])
  @@index([inputHash])
  @@index([projectId, pageKey, feature, createdAt])
  @@index([competitorId, feature, createdAt])
}

/// One Lighthouse run of one page on one device.
///
/// Read by (projectId, pageKey), not pageId: each crawl writes new Page rows,
/// and results tied to a row id disappeared from every screen at the next
/// crawl. The worker keeps the newest runs per page and device (see
/// run-performance), which bounds history now that crawls no longer cascade.
model PerformanceAudit {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The page's URL identity (see pageKeyOf), stable across crawls.
  pageKey       String
  /// The crawl's page row it was measured for. Null once that crawl is pruned.
  pageId        String?
  page          Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  strategy      String
  performance   Float?
  accessibility Float?
  bestPractices Float?
  seo           Float?
  fcp           Float?
  lcp           Float?
  cls           Float?
  tbt           Float?
  inp           Float?
  /// Lab TTFB and Speed Index were computed but had nowhere to go.
  ttfb          Float?
  speedIndex    Float?
  rawData       Json?
  opportunities Json?
  diagnostics   Json?
  createdAt     DateTime @default(now())

  @@index([pageId])
  @@index([projectId, pageKey, strategy, createdAt])
}

/// source: manual | serp | ai
/// status: pending | queued | crawling | analyzing | ready | failed | skipped
model Competitor {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain      String
  name        String?
  source      String
  /// Deprecated: superseded by `confidence`. Never written; kept to avoid a destructive migration.
  relevance   Float?
  pageCount   Int     @default(0)
  seoScore    Float?
  performance Float?
  status      String
  statusError String?
  metadata    Json?

  /// COMPETITOR CONFIDENCE 0-100. Null when nothing could be measured.
  confidence     Float?
  confidenceBand String?

  crawlDone      Int       @default(0)
  crawlTotal     Int       @default(0)
  lastCrawledAt  DateTime?
  lastAnalyzedAt DateTime?

  title        String?
  description  String?
  country      String?
  language     String?
  businessType String?
  audience     String?

  queryCount    Int    @default(0)
  topQueryCount Int    @default(0)
  avgPosition   Float?

  pinned   Boolean @default(false)
  excluded Boolean @default(false)

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  pages         CompetitorPage[]
  analyses      CompetitorAnalysis[]
  opportunities Opportunity[]
  aiResults     AiResult[]

  @@unique([projectId, domain])
  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, confidence])
}

model CompetitorPage {
  id              String     @id @default(cuid())
  competitorId    String
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  url             String
  finalUrl        String?
  isHttps         Boolean?
  statusCode      Int?
  title           String?
  metaDescription String?
  h1              String?
  h2Count         Int?
  canonicalUrl    String?
  wordCount       Int?
  internalLinks   Int?
  imageCount      Int?
  missingAlt      Int?
  schemaCount     Int?
  /// schema.org @type values found in the page's JSON-LD.
  schema          Json?
  /// H2/H3 texts, capped. Topics for the comparison (Phase 4.1); no body text.
  headings        Json?
  indexable       Boolean?
  xRobotsTag      String?
  pageType        String?
  seoScore        Float?
  rawData         Json?
  status          String     @default("pending")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([competitorId, url])
  @@index([competitorId])
}

/// source: seed | ai | page | manual
/// intent: transactional | commercial | informational | navigational
/// status: pending | fetched | unavailable | failed
model CompetitorQuery {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  query        String
  source       String
  intent       String    @default("informational")
  /// NOT NULL so the unique tuple works — Postgres treats NULLs as distinct.
  locationCode Int       @default(2840)
  languageCode String    @default("en")
  relevance    Float?
  searchVolume Int?
  difficulty   Float?
  cpc          Float?
  /// Where the user's own site ranks for this query, when known.
  selfPosition Int?
  selfUrl      String?
  status       String    @default("pending")
  checkedAt    DateTime?
  createdAt    DateTime  @default(now())

  results SerpResult[]

  @@unique([projectId, query, locationCode, languageCode])
  @@index([projectId])
}

/// resultType: organic | featured_snippet | paa | local_pack
model SerpResult {
  id         String          @id @default(cuid())
  queryId    String
  query      CompetitorQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  position   Int
  domain     String
  url        String
  title      String?
  snippet    String?
  resultType String          @default("organic")
  provider   String
  fetchedAt  DateTime        @default(now())

  @@unique([queryId, position, resultType])
  @@index([queryId])
  @@index([domain])
}

/// Append-only. One row per analysis run, which gives per-competitor history.
model CompetitorAnalysis {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  seoScore            Float?
  technicalScore      Float?
  onPageScore         Float?
  contentScore        Float?
  performanceScore    Float?
  internalLinksScore  Float?
  structuredDataScore Float?
  /// Weights after redistribution, so a stored score can always be audited.
  measuredWeights     Json?
  /// SeoDimensionId[] that could not be measured.
  notMeasured         Json?

  confidence      Float?
  confidenceParts Json?

  pagesAnalyzed    Int    @default(0)
  avgWordCount     Float?
  avgInternalLinks Float?
  schemaCoverage   Float?

  summary    String?
  strengths  Json?
  weaknesses Json?

  /// The deterministic comparison with your site (CompetitorComparison):
  /// observed facts only. AI interpretation lives in AiResult, by fact id.
  comparison Json?

  aiUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([competitorId, createdAt])
}

/// kind: topic | keyword | page-type | schema | depth
/// status: open | in-progress | done | dismissed
model ContentGap {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Stable identity (kind plus normalized subject), so a re-run updates the
  /// gap in place and keeps the user's status on it.
  key    String?
  kind   String
  title  String
  detail String?
  query  String?

  selfUrl       String?
  selfWordCount Int?

  competitorCount        Int     @default(0)
  competitorIds          Json?
  avgCompetitorWordCount Float?
  bestCompetitorUrl      String?

  searchVolume  Int?
  relevance     Float?
  businessValue Float?

  status    String   @default("open")
  aiUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity?

  @@unique([projectId, key])
  @@index([projectId, status])
}

/// category: content | technical | onpage | performance | structured-data | internal-links
/// effort: low | medium | high
/// status: open | in-progress | done | dismissed (the user's; the crawl's verdict is resolvedAt)
/// source: site (Site Intelligence, Phase 3.3) | competitor (content gaps, Phase 4.2)
model Opportunity {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  gapId String?     @unique
  gap   ContentGap? @relation(fields: [gapId], references: [id], onDelete: Cascade)

  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  /// Stable identity from the deterministic engine ("check:meta",
  /// "links:orphans"), so re-deriving after a crawl updates this row and keeps
  /// its status and history instead of creating a new one.
  key    String?
  source String  @default("site")

  category  String
  title     String
  rationale String?
  action    String?
  /// The single first step, written by AI when it has run.
  nextStep  String?

  /// PRIORITY / OPPORTUNITY SCORE 0-100. Always computed by code, never by AI.
  score Float
  band  String
  parts Json?

  effort     String?
  /// 0..1 confidence in the evidence behind it.
  confidence Float?

  /// Verifiable facts from the crawl, and the hash the AI wording was written
  /// against: when the facts change, the wording is reset rather than left stale.
  evidence      Json?
  /// Affected pages as { key, url, path }, capped.
  affectedUrls  Json?
  affectedCount Int     @default(0)

  /// What was affected when first found, for re-crawl comparison (Phase 4.7).
  baselineCount   Int?
  baselineCrawlId String?
  /// The crawl this was last derived from.
  crawlId         String?
  /// When a later crawl no longer found the condition. The crawl's verdict,
  /// separate from the user's `status`.
  resolvedAt      DateTime?

  /// The AiResult whose wording is shown, when aiUsed.
  aiResultId String?

  status    String   @default("open")
  aiUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
  @@index([projectId, status, score])
}

/// One atomic SEO/GEO knowledge item (Phase 1.5).
///
/// Mirrors knowledge/knowledge-corpus.json, which is the authored source of
/// truth. Rows are replaced wholesale by `pnpm knowledge:ingest`; nothing else
/// writes here, so the corpus file and the table can never drift.
///
/// knowledgeType: authoritative | heuristic | research | myth
/// status:        active | revised | superseded | needs_verification
model KnowledgeItem {
  /// The corpus slug, e.g. "seo-tech-robots-5xx-disallow".
  id String @id

  domain        String
  category      String
  topic         String
  subtopic      String?
  knowledgeType String
  claimType     String

  title             String
  principle         String
  explanation       String
  whyItMatters      String
  recommendedAction String
  /// Never null. An item with no stated limit is usually an overclaim.
  limitations       String

  appliesWhen      Json
  doesNotApplyWhen Json
  relatedIssues    Json
  relatedKnowledge Json

  /// Deterministic CheckIds this item can explain. The primary retrieval key,
  /// alongside `topic` — Phase 1.7 routes on metadata before embeddings.
  checks        String[]
  applicability String[]
  entities      String[]
  tags          String[]
  /// Populated in Phase 2, when page-type-specific knowledge is added.
  pageTypes     String[]

  evidenceType     String
  evidenceStrength String
  confidence       String

  sourceName      String
  sourcePublisher String
  sourceUrl       String?
  sourceType      String
  sourceLocation  String?
  sourceQuote     String?
  sourceLocalPath String?

  /// False when the source document was not read in the pass that produced the
  /// item. Such items carry no quote and no location, and retrieval prefers a
  /// verified item when both cover the same ground.
  verified     Boolean
  sourceSupport String

  status       String
  supersededBy String?
  /// Ids in KnowledgePolicy that override this item's phrasing.
  governingPolicies String[]

  version       String
  lastVerified  String?
  reviewBy      String?
  /// Corpus build stamp, copied to AiResult.knowledgeVersion for traceability.
  corpusVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, knowledgeType])
  @@index([topic])
  @@index([domain, category])
}

/// A resolved conflict (Phase 1.5). Overrides an item's own phrasing.
///
/// Every disagreement found during extraction is decided rather than left open,
/// so the model never has to arbitrate between two sources at generation time.
model KnowledgePolicy {
  id        String @id
  question  String
  decision  String
  rationale String
  directive String
  /// Phrasings the model must never emit.
  neverSay Json
  /// The rejected position, kept so the model can recognise and contradict it.
  losingClaim String
  caveat      String?

  appliesToItems  String[]
  appliesToChecks String[]

  confidence    String
  corpusVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
